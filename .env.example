# Environment Configuration
NODE_ENV=production
PORT=3001

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=whatsapp_monitor_prod
DB_USERNAME=mrunal.a
DB_PASSWORD=Mrunal2004

# Development Database (for local development)
DB_NAME_DEV=whatsapp_monitor_dev
DB_NAME_TEST=whatsapp_monitor_test

# WhatsApp Web.js Configuration
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
CHROME_BIN=/usr/bin/chromium
CHROME_PATH=/usr/bin/chromium

# Server Configuration
BACKEND_PORT=3001
FRONTEND_PORT=3000
HTTP_PORT=80
HTTPS_PORT=443

# Frontend Configuration
VITE_API_URL=http://localhost:3001
VITE_SOCKET_URL=http://localhost:3001
VITE_APP_TITLE=WhatsApp Monitor

# RSS Configuration
RSS_TITLE=WhatsApp Monitor Feed
RSS_DESCRIPTION=Real-time WhatsApp group messages
RSS_FEED_URL=http://localhost:3001/rss/feed.xml
RSS_SITE_URL=http://localhost:3001

# File Paths (relative to container)
MEDIA_DIR=./media
RSS_DIR=./rss
BACKUPS_DIR=./backups

# Security (Optional)
JWT_SECRET=your_jwt_secret_here
SESSION_SECRET=your_session_secret_here

# Email Configuration (if using notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional Features
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_WEBHOOK_NOTIFICATIONS=false
WEBHOOK_URL=

# Monitoring
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100